<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.acme.sica.infraestructura.ui.javafx.controlador.BloqueoPersonaControlador"
            fitToWidth="true" hbarPolicy="NEVER" styleClass="form-scroll">
    <VBox alignment="TOP_CENTER" styleClass="dashboard-root">
        <padding><Insets top="28" right="56" bottom="28" left="56"/></padding>
        <VBox styleClass="form-card">
            <HBox styleClass="screen-header">
                <Label text="Bloquear / Desbloquear Personas" styleClass="screen-title" HBox.hgrow="ALWAYS"/>
                <Button fx:id="botonVolver" text="← Volver" onAction="#volverAlDashboard" styleClass="back-button"/>
            </HBox>
            <GridPane hgap="10" vgap="10">
                <Label text="Persona:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <ComboBox fx:id="comboPersonas" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="450"/>
                <Label text="Motivo:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextArea fx:id="campoMotivo" GridPane.rowIndex="1" GridPane.columnIndex="1" prefRowCount="3" wrapText="true"/>
                <columnConstraints><ColumnConstraints minWidth="100"/><ColumnConstraints minWidth="450"/></columnConstraints>
            </GridPane>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="Bloquear" onAction="#bloquear" styleClass="dashboard-button"/>
                <Button text="Desbloquear seleccionado" onAction="#desbloquear" styleClass="dashboard-button secondary"/>
            </HBox>
            <Label fx:id="etiquetaMensaje" styleClass="login-message"/>
            <Label text="Personas bloqueadas" styleClass="dashboard-subtitle"/>
            <TableView fx:id="tablaBloqueadas" prefHeight="360">
                <columns>
                    <TableColumn fx:id="columnaDocumento" text="Documento" prefWidth="200"/>
                    <TableColumn fx:id="columnaNombre" text="Persona" prefWidth="300"/>
                    <TableColumn fx:id="columnaMotivo" text="Motivo" prefWidth="420"/>
                    <TableColumn fx:id="columnaAccion" text="Estado" prefWidth="140"/>
                </columns>
            </TableView>
        </VBox>
    </VBox>
</ScrollPane>
