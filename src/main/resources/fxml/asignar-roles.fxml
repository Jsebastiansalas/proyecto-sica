<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.acme.sica.infraestructura.ui.javafx.controlador.AsignarRolesControlador"
            fitToWidth="true" hbarPolicy="NEVER" styleClass="form-scroll">

    <VBox alignment="TOP_CENTER" styleClass="dashboard-root">
        <padding><Insets top="28" right="56" bottom="28" left="56"/></padding>

        <VBox styleClass="form-card">
            <HBox styleClass="screen-header">
                <Label text="Asignar Roles a Usuarios" styleClass="screen-title" HBox.hgrow="ALWAYS"/>
                <Button text="← Volver" onAction="#volverAlDashboard" styleClass="back-button"/>
            </HBox>

            <Label text="Seleccione un usuario" styleClass="dashboard-subtitle"/>
            <ComboBox fx:id="comboUsuarios" promptText="Seleccione un usuario" prefWidth="500"/>

            <Label text="Roles activos" styleClass="dashboard-subtitle"/>
            <ScrollPane fitToWidth="true" prefHeight="240" prefWidth="500" styleClass="form-scroll">
                <content>
                    <VBox fx:id="contenedorRoles" spacing="10"/>
                </content>
            </ScrollPane>

            <Button text="Guardar asignación" onAction="#guardarAsignacion" styleClass="dashboard-button"/>
            <Label fx:id="etiquetaMensaje" styleClass="login-message"/>
        </VBox>
    </VBox>
</ScrollPane>
