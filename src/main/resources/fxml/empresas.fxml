<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.acme.sica.infraestructura.ui.javafx.controlador.EmpresaControlador"
            fitToWidth="true" hbarPolicy="NEVER" styleClass="form-scroll">

    <VBox alignment="TOP_CENTER" styleClass="dashboard-root">
        <padding><Insets top="28" right="56" bottom="28" left="56"/></padding>

        <VBox styleClass="form-card">
            <HBox styleClass="screen-header">
                <Label text="Gestión de Empresas" styleClass="screen-title" HBox.hgrow="ALWAYS"/>
                <Button fx:id="botonVolver" text="← Volver" onAction="#volverAlDashboard" styleClass="back-button"/>
            </HBox>

            <GridPane hgap="10" vgap="10">
                <Label text="Nombre:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="campoNombre" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Ubicación:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="campoUbicacion" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Activa:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <CheckBox fx:id="checkActiva" GridPane.rowIndex="2" GridPane.columnIndex="1" selected="true"/>

                <columnConstraints>
                    <ColumnConstraints minWidth="100"/>
                    <ColumnConstraints minWidth="450"/>
                </columnConstraints>
            </GridPane>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="botonGuardar" text="Guardar" onAction="#guardarEmpresa" styleClass="dashboard-button"/>
                <Button fx:id="botonEliminar" text="Eliminar" onAction="#eliminarEmpresa" styleClass="dashboard-button secondary"/>
                <Button fx:id="botonLimpiar" text="Limpiar" onAction="#limpiarFormulario" styleClass="dashboard-button secondary"/>
            </HBox>

            <Label fx:id="etiquetaMensaje" styleClass="login-message"/>

            <TableView fx:id="tablaEmpresas" prefHeight="320" prefWidth="800">
                <columns>
                    <TableColumn fx:id="columnaNombre" text="Nombre" prefWidth="280"/>
                    <TableColumn fx:id="columnaUbicacion" text="Ubicación" prefWidth="380"/>
                    <TableColumn fx:id="columnaEstado" text="Estado" prefWidth="100"/>
                </columns>
            </TableView>
        </VBox>
    </VBox>
</ScrollPane>
