<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.acme.sica.infraestructura.ui.javafx.controlador.DashboardControlador"
      alignment="CENTER"
      spacing="16"
      styleClass="dashboard-root">

    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <Label text="SICA" styleClass="login-title"/>
    <Label fx:id="etiquetaBienvenida" styleClass="dashboard-welcome"/>
    <Label fx:id="etiquetaRol" styleClass="dashboard-subtitle"/>

    <Button fx:id="botonGestionarRoles"
            text="Gestionar Roles"
            onAction="#abrirGestionRoles"
            styleClass="dashboard-button"/>

    <Button fx:id="botonGestionarPermisos"
            text="Gestionar Permisos"
            onAction="#abrirGestionPermisos"
            styleClass="dashboard-button"/>

    <Button fx:id="botonAsignarRoles"
            text="Asignar Roles a Usuarios"
            onAction="#abrirAsignacionRoles"
            styleClass="dashboard-button"/>

    <Button fx:id="botonConsultarBitacora"
            text="Consultar Bitácora"
            onAction="#abrirConsultarBitacora"
            styleClass="dashboard-button"/>

    <Button fx:id="botonGestionarEmpresas"
            text="Gestionar Empresas"
            onAction="#abrirGestionEmpresas"
            styleClass="dashboard-button"/>

    <Button fx:id="botonGestionarFuncionarios"
            text="Gestionar Funcionarios"
            onAction="#abrirGestionFuncionarios"
            styleClass="dashboard-button"/>

    <Button fx:id="botonGestionarPersonas"
            text="Gestionar Personas"
            onAction="#abrirGestionPersonas"
            styleClass="dashboard-button"/>

    <Button fx:id="botonPreRegistrarInvitado"
            text="Pre-registrar Invitado"
            onAction="#abrirPreRegistrarInvitado"
            styleClass="dashboard-button"/>

    <Button fx:id="botonCerrarSesion"
            text="Cerrar Sesión"
            onAction="#cerrarSesion"
            styleClass="dashboard-button secondary"/>

</VBox>
