<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.acme.sica.infraestructura.ui.javafx.controlador.BitacoraControlador"
            fitToWidth="true" hbarPolicy="NEVER" styleClass="form-scroll">

    <VBox alignment="TOP_CENTER" styleClass="dashboard-root">
        <padding><Insets top="28" right="56" bottom="28" left="56"/></padding>

        <VBox styleClass="form-card">
            <HBox styleClass="screen-header">
                <Label text="Bitácora de Auditoría" styleClass="screen-title" HBox.hgrow="ALWAYS"/>
                <Button fx:id="botonVolver" text="← Volver" onAction="#volverAlDashboard" styleClass="back-button"/>
            </HBox>

            <GridPane hgap="10" vgap="10">
                <Label text="Usuario:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="campoUsername" GridPane.rowIndex="0" GridPane.columnIndex="1" promptText="nombre de usuario"/>

                <Label text="Acción:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                <TextField fx:id="campoAccion" GridPane.rowIndex="0" GridPane.columnIndex="3" promptText="ej. CREAR_ROL"/>

                <Label text="Entidad:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="campoEntidad" GridPane.rowIndex="1" GridPane.columnIndex="1" promptText="ej. ROL"/>

                <Label text="Desde:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                <DatePicker fx:id="campoFechaDesde" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

                <Label text="Hasta:" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
                <DatePicker fx:id="campoFechaHasta" GridPane.rowIndex="2" GridPane.columnIndex="3"/>

                <columnConstraints>
                    <ColumnConstraints minWidth="70"/>
                    <ColumnConstraints minWidth="220"/>
                    <ColumnConstraints minWidth="70"/>
                    <ColumnConstraints minWidth="220"/>
                </columnConstraints>
            </GridPane>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="Buscar" onAction="#buscar" styleClass="dashboard-button"/>
                <Button text="Limpiar" onAction="#limpiarFiltros" styleClass="dashboard-button secondary"/>
            </HBox>

            <Label fx:id="etiquetaMensaje" styleClass="login-message"/>

            <TableView fx:id="tablaBitacora" prefHeight="420" prefWidth="1000">
                <columns>
                    <TableColumn fx:id="columnaFecha" text="Fecha" prefWidth="160"/>
                    <TableColumn fx:id="columnaUsuario" text="Usuario" prefWidth="140"/>
                    <TableColumn fx:id="columnaAccion" text="Acción" prefWidth="200"/>
                    <TableColumn fx:id="columnaEntidad" text="Entidad" prefWidth="120"/>
                    <TableColumn fx:id="columnaDetalle" text="Detalle" prefWidth="320"/>
                </columns>
            </TableView>
        </VBox>
    </VBox>
</ScrollPane>
