<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.acme.sica.infraestructura.ui.javafx.controlador.BitacoraControlador"
      alignment="CENTER"
      spacing="16"
      styleClass="dashboard-root">

    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <Label text="Bitácora de Auditoría" styleClass="login-title"/>

    <GridPane hgap="10" vgap="10">
        <Label text="Usuario:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="campoUsername" GridPane.rowIndex="0" GridPane.columnIndex="1" promptText="nombre de usuario"/>

        <Label text="Acción:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
        <TextField fx:id="campoAccion" GridPane.rowIndex="0" GridPane.columnIndex="3" promptText="ej. CREAR_ROL"/>

        <Label text="Entidad:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="campoEntidad" GridPane.rowIndex="1" GridPane.columnIndex="1" promptText="ej. ROL"/>

        <Label text="Desde:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
        <DatePicker fx:id="campoFechaDesde" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

        <Label text="Hasta:" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
        <DatePicker fx:id="campoFechaHasta" GridPane.rowIndex="2" GridPane.columnIndex="3"/>

        <columnConstraints>
            <ColumnConstraints minWidth="70"/>
            <ColumnConstraints minWidth="180"/>
            <ColumnConstraints minWidth="70"/>
            <ColumnConstraints minWidth="180"/>
        </columnConstraints>
    </GridPane>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Buscar" onAction="#buscar" styleClass="dashboard-button"/>
        <Button text="Limpiar" onAction="#limpiarFiltros" styleClass="dashboard-button secondary"/>
    </HBox>

    <Label fx:id="etiquetaMensaje" styleClass="login-message"/>

    <TableView fx:id="tablaBitacora" prefHeight="320" prefWidth="760">
        <columns>
            <TableColumn fx:id="columnaFecha" text="Fecha" prefWidth="150"/>
            <TableColumn fx:id="columnaUsuario" text="Usuario" prefWidth="120"/>
            <TableColumn fx:id="columnaAccion" text="Acción" prefWidth="170"/>
            <TableColumn fx:id="columnaEntidad" text="Entidad" prefWidth="100"/>
            <TableColumn fx:id="columnaDetalle" text="Detalle" prefWidth="220"/>
        </columns>
    </TableView>

    <Button fx:id="botonVolver" text="Volver" onAction="#volverAlDashboard" styleClass="dashboard-button secondary"/>

</VBox>
