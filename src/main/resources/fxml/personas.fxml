<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.acme.sica.infraestructura.ui.javafx.controlador.PersonaControlador"
            fitToWidth="true" hbarPolicy="NEVER" styleClass="form-scroll">

    <VBox alignment="TOP_CENTER" styleClass="dashboard-root">
        <padding><Insets top="28" right="56" bottom="28" left="56"/></padding>

        <VBox styleClass="form-card">
            <HBox styleClass="screen-header">
                <Label text="Gestión de Personas" styleClass="screen-title" HBox.hgrow="ALWAYS"/>
                <Button fx:id="botonVolver" text="← Volver" onAction="#volverAlDashboard" styleClass="back-button"/>
            </HBox>

            <GridPane hgap="10" vgap="10">
                <Label text="Documento:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="campoDocumento" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Nombre:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="campoNombre" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Tipo:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <ComboBox fx:id="comboTipo" GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="400"/>

                <Label text="Foto URL:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="campoFotoUrl" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <columnConstraints>
                    <ColumnConstraints minWidth="100"/>
                    <ColumnConstraints minWidth="450"/>
                </columnConstraints>
            </GridPane>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="botonGuardar" text="Guardar" onAction="#guardarPersona" styleClass="dashboard-button"/>
                <Button fx:id="botonEliminar" text="Eliminar" onAction="#eliminarPersona" styleClass="dashboard-button secondary"/>
                <Button fx:id="botonLimpiar" text="Limpiar" onAction="#limpiarFormulario" styleClass="dashboard-button secondary"/>
            </HBox>

            <Label fx:id="etiquetaMensaje" styleClass="login-message"/>

            <TableView fx:id="tablaPersonas" prefHeight="360" prefWidth="800">
                <columns>
                    <TableColumn fx:id="columnaDocumento" text="Documento" prefWidth="160"/>
                    <TableColumn fx:id="columnaNombre" text="Nombre" prefWidth="300"/>
                    <TableColumn fx:id="columnaTipo" text="Tipo" prefWidth="150"/>
                    <TableColumn fx:id="columnaEstado" text="Estado" prefWidth="120"/>
                </columns>
            </TableView>
        </VBox>
    </VBox>
</ScrollPane>
