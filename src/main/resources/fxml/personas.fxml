<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.acme.sica.infraestructura.ui.javafx.controlador.PersonaControlador"
      alignment="CENTER"
      spacing="16"
      styleClass="dashboard-root">

    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <Label text="Gestión de Personas" styleClass="login-title"/>

    <GridPane hgap="10" vgap="10">
        <Label text="Documento:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="campoDocumento" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Nombre:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="campoNombre" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Tipo:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <ComboBox fx:id="comboTipo" GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="300"/>

        <Label text="Foto URL:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="campoFotoUrl" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Bloqueada:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <CheckBox fx:id="checkBloqueada" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <columnConstraints>
            <ColumnConstraints minWidth="100"/>
            <ColumnConstraints minWidth="300"/>
        </columnConstraints>
    </GridPane>

    <HBox spacing="10" alignment="CENTER">
        <Button fx:id="botonGuardar" text="Guardar" onAction="#guardarPersona" styleClass="dashboard-button"/>
        <Button fx:id="botonEliminar" text="Eliminar" onAction="#eliminarPersona" styleClass="dashboard-button secondary"/>
        <Button fx:id="botonLimpiar" text="Limpiar" onAction="#limpiarFormulario" styleClass="dashboard-button secondary"/>
    </HBox>

    <Label fx:id="etiquetaMensaje" styleClass="login-message"/>

    <TableView fx:id="tablaPersonas" prefHeight="280" prefWidth="700">
        <columns>
            <TableColumn fx:id="columnaDocumento" text="Documento" prefWidth="140"/>
            <TableColumn fx:id="columnaNombre" text="Nombre" prefWidth="250"/>
            <TableColumn fx:id="columnaTipo" text="Tipo" prefWidth="130"/>
            <TableColumn fx:id="columnaEstado" text="Estado" prefWidth="100"/>
        </columns>
    </TableView>

    <Button fx:id="botonVolver" text="Volver" onAction="#volverAlDashboard" styleClass="dashboard-button secondary"/>

</VBox>
