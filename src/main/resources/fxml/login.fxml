<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.acme.sica.infraestructura.ui.javafx.controlador.LoginControlador"
      alignment="CENTER"
      styleClass="login-root">

    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <VBox styleClass="login-card">
        <Label text="SICA" styleClass="login-title" alignment="CENTER"/>
        <Label text="ZONA ACME" styleClass="login-tagline" alignment="CENTER"/>
        <Label text="Sistema Integrado de Control de Acceso"
               styleClass="login-subtitle" alignment="CENTER"/>

        <TextField fx:id="campoUsuario"
                   promptText="Usuario"
                   styleClass="login-field"/>

        <HBox spacing="8" alignment="CENTER">
            <PasswordField fx:id="campoContrasena"
                           promptText="Contraseña"
                           styleClass="login-field"
                           HBox.hgrow="ALWAYS"/>

            <TextField fx:id="campoContrasenaVisible"
                       promptText="Contraseña"
                       styleClass="login-field"
                       visible="false"
                       managed="false"
                       HBox.hgrow="ALWAYS"/>

            <Button fx:id="botonMostrarContrasena"
                    text="👁"
                    onAction="#toggleContrasena"
                    styleClass="eye-button"/>
        </HBox>

        <Button text="Ingresar"
                onAction="#manejarLogin"
                styleClass="login-button"/>

        <Label fx:id="etiquetaMensaje"
               styleClass="login-message"/>
    </VBox>

</VBox>
