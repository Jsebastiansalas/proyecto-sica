<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.acme.sica.infraestructura.ui.javafx.controlador.PreRegistrarInvitadoControlador"
            fitToWidth="true" hbarPolicy="NEVER" styleClass="form-scroll">

    <VBox alignment="TOP_CENTER" styleClass="dashboard-root">
        <padding><Insets top="28" right="56" bottom="28" left="56"/></padding>

        <VBox styleClass="form-card">
            <HBox styleClass="screen-header">
                <Label text="Pre-registrar Invitado" styleClass="screen-title" HBox.hgrow="ALWAYS"/>
                <Button fx:id="botonVolver" text="← Volver" onAction="#volverAlDashboard" styleClass="back-button"/>
            </HBox>

            <GridPane hgap="10" vgap="10">
                <Label text="Persona:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <ComboBox fx:id="comboPersonas" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="450"/>

                <Label text="Funcionario:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <ComboBox fx:id="comboFuncionarios" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="450"/>

                <Label text="Fecha:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <DatePicker fx:id="campoFecha" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Hora:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="campoHora" GridPane.rowIndex="3" GridPane.columnIndex="1" promptText="HH:mm"/>

                <Label text="Motivo:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <TextArea fx:id="campoMotivo" GridPane.rowIndex="4" GridPane.columnIndex="1" prefRowCount="3" wrapText="true"/>

                <columnConstraints>
                    <ColumnConstraints minWidth="100"/>
                    <ColumnConstraints minWidth="450"/>
                </columnConstraints>
            </GridPane>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="Pre-registrar" onAction="#preRegistrar" styleClass="dashboard-button"/>
                <Button text="Limpiar" onAction="#limpiarFormulario" styleClass="dashboard-button secondary"/>
            </HBox>

            <Label fx:id="etiquetaMensaje" styleClass="login-message"/>

            <TableView fx:id="tablaVisitas" prefHeight="320" prefWidth="900">
                <columns>
                    <TableColumn fx:id="columnaPersona" text="Invitado" prefWidth="240"/>
                    <TableColumn fx:id="columnaFuncionario" text="Funcionario" prefWidth="240"/>
                    <TableColumn fx:id="columnaFecha" text="Fecha/Hora" prefWidth="200"/>
                    <TableColumn fx:id="columnaEstado" text="Estado" prefWidth="150"/>
                </columns>
            </TableView>
        </VBox>
    </VBox>
</ScrollPane>
