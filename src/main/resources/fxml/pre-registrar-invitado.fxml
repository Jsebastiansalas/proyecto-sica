<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.acme.sica.infraestructura.ui.javafx.controlador.PreRegistrarInvitadoControlador"
      alignment="CENTER"
      spacing="16"
      styleClass="dashboard-root">

    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <Label text="Pre-registrar Invitado" styleClass="login-title"/>

    <GridPane hgap="10" vgap="10">
        <Label text="Persona:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="comboPersonas" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="350"/>

        <Label text="Funcionario:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <ComboBox fx:id="comboFuncionarios" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="350"/>

        <Label text="Fecha:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <DatePicker fx:id="campoFecha" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Hora:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="campoHora" GridPane.rowIndex="3" GridPane.columnIndex="1" promptText="HH:mm"/>

        <Label text="Motivo:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextArea fx:id="campoMotivo" GridPane.rowIndex="4" GridPane.columnIndex="1" prefRowCount="3" wrapText="true"/>

        <columnConstraints>
            <ColumnConstraints minWidth="100"/>
            <ColumnConstraints minWidth="350"/>
        </columnConstraints>
    </GridPane>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Pre-registrar" onAction="#preRegistrar" styleClass="dashboard-button"/>
        <Button text="Limpiar" onAction="#limpiarFormulario" styleClass="dashboard-button secondary"/>
    </HBox>

    <Label fx:id="etiquetaMensaje" styleClass="login-message"/>

    <TableView fx:id="tablaVisitas" prefHeight="260" prefWidth="760">
        <columns>
            <TableColumn fx:id="columnaPersona" text="Invitado" prefWidth="200"/>
            <TableColumn fx:id="columnaFuncionario" text="Funcionario" prefWidth="200"/>
            <TableColumn fx:id="columnaFecha" text="Fecha/Hora" prefWidth="180"/>
            <TableColumn fx:id="columnaEstado" text="Estado" prefWidth="130"/>
        </columns>
    </TableView>

    <Button fx:id="botonVolver" text="Volver" onAction="#volverAlDashboard" styleClass="dashboard-button secondary"/>

</VBox>
