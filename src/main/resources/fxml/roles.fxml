<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.acme.sica.infraestructura.ui.javafx.controlador.RolControlador"
      alignment="CENTER"
      spacing="16"
      styleClass="dashboard-root">

    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <Label text="Gestión de Roles" styleClass="login-title"/>

    <GridPane hgap="10" vgap="10">
        <Label text="Nombre:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="campoNombre" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Descripción:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="campoDescripcion" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <columnConstraints>
            <ColumnConstraints minWidth="100"/>
            <ColumnConstraints minWidth="250"/>
        </columnConstraints>
    </GridPane>

    <HBox spacing="10" alignment="CENTER">
        <Button fx:id="botonGuardar" text="Guardar" onAction="#guardarRol" styleClass="dashboard-button"/>
        <Button fx:id="botonEliminar" text="Eliminar" onAction="#eliminarRol" styleClass="dashboard-button secondary"/>
        <Button fx:id="botonLimpiar" text="Limpiar" onAction="#limpiarFormulario" styleClass="dashboard-button secondary"/>
    </HBox>

    <Label fx:id="etiquetaMensaje" styleClass="login-message"/>

    <TableView fx:id="tablaRoles" prefHeight="250" prefWidth="500">
        <columns>
            <TableColumn fx:id="columnaNombre" text="Nombre" prefWidth="150"/>
            <TableColumn fx:id="columnaDescripcion" text="Descripción" prefWidth="330"/>
        </columns>
    </TableView>

    <Button fx:id="botonVolver" text="Volver" onAction="#volverAlDashboard" styleClass="dashboard-button secondary"/>

</VBox>
