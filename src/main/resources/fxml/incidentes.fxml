<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.acme.sica.infraestructura.ui.javafx.controlador.IncidenteControlador"
            fitToWidth="true" hbarPolicy="NEVER" styleClass="form-scroll">
    <VBox alignment="TOP_CENTER" styleClass="dashboard-root">
        <padding><Insets top="28" right="56" bottom="28" left="56"/></padding>
        <VBox styleClass="form-card">
            <HBox styleClass="screen-header">
                <Label text="Registrar Incidente" styleClass="screen-title" HBox.hgrow="ALWAYS"/>
                <Button fx:id="botonVolver" text="← Volver" onAction="#volverAlDashboard" styleClass="back-button"/>
            </HBox>
            <GridPane hgap="10" vgap="10">
                <Label text="Persona:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <ComboBox fx:id="comboPersonas" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="450"/>
                <Label text="Gravedad:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <ComboBox fx:id="comboGravedad" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="450"/>
                <Label text="Descripción:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextArea fx:id="campoDescripcion" GridPane.rowIndex="2" GridPane.columnIndex="1" prefRowCount="4" wrapText="true"/>
                <columnConstraints><ColumnConstraints minWidth="100"/><ColumnConstraints minWidth="450"/></columnConstraints>
            </GridPane>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="Registrar" onAction="#registrar" styleClass="dashboard-button"/>
            </HBox>
            <Label fx:id="etiquetaMensaje" styleClass="login-message"/>
            <TableView fx:id="tablaIncidentes" prefHeight="360">
                <columns>
                    <TableColumn fx:id="columnaFecha" text="Fecha" prefWidth="160"/>
                    <TableColumn fx:id="columnaPersona" text="Persona" prefWidth="220"/>
                    <TableColumn fx:id="columnaGravedad" text="Gravedad" prefWidth="140"/>
                    <TableColumn fx:id="columnaDescripcion" text="Descripción" prefWidth="400"/>
                    <TableColumn fx:id="columnaUsuario" text="Registrado por" prefWidth="160"/>
                </columns>
            </TableView>
        </VBox>
    </VBox>
</ScrollPane>
